  },
  "areas": [
    {
      "areaId": "渭水-北门",
      "name": "北门",
      "precision": "derived",
      "sourceNote": "北门 37 个车位来自手绘车位布局（index.html BM_SPOTS，像素与车位格子一一对应），经 BM_GEO 标定（0.207 m/px、绕地块中心旋转 16.7°、地块中心为实测点）换算为 GCJ-02。落点依赖标定比例与地块中心，因此是 derived 而不是 measured。"
    },
    {
      "areaId": "渭水-朝晖体育场南",
      "name": "朝晖体育场南",
      "precision": "derived",
      "sourceNote": "朝晖 36 个桩位由手绘弧线像素（arcPx：左弧 12 位 180°→128°、右弧 24 位 52°→0°）经体育场外接框配准（chGeo：手绘图 439×936px ↔ 实测体育场 WGS84 外接框）换算。弧参数是产品方指定的分布，非逐桩实测，因此是 derived。"
    },
    {
      "areaId": "渭水-20号楼",
      "name": "20号楼",
      "precision": "schematic",
      "sourceNote": "20号楼 24 个桩位由产品方红线两端配准后按 E-01→E-24 自西向东等分推算（约 5.25m 一档），只保证点在线上的相对次序，因此是 schematic。"
    },
    {
      "areaId": "渭水-物业服务中心",
      "name": "物业服务中心",
      "precision": "schematic",
      "sourceNote": "物业服务中心 12 个桩位由产品方红线两端配准后按 W-01→W-12 自下而上等分推算（约 3.8m 一档），只保证点在线上的相对次序，因此是 schematic。"
    }
  ],
